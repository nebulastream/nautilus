nir 1.0

func export @mem : (ptr, i64) -> f64 {
  alloca 16 align 8
  alloca 4 align 4
^b0(%0: ptr, %1: i64):
  %2 = alloca 0
  %3 = alloca 1
  %4 = add %0, %1
  %5 = load %4 : f64
  %6 = load %4 : i32 align 2
  %7 = load %0 : i8 align 4096
  store %2, %5
  store %3, 7:i32
  store %2, %5 align 1
  %11 = load %2 : f64
  ret %11
}
