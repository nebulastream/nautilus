nir 1.0
module "arith"

func export @ints : (i64, i64) -> i64 {
^b0(%0: i64, %1: i64):
  %2 = add %0, %1
  %3 = sub %2, 1:i64
  %4 = mul %3, %0
  %5 = div.s %4, 3:i64
  %6 = div.u %5, 3:i64
  %7 = rem.s %6, 7:i64
  %8 = rem.u %7, 7:i64
  %9 = band %8, 255:i64
  %10 = bor %9, 16:i64
  %11 = bxor %10, %1
  %12 = bnot %11
  %13 = shl %12, 2:i64
  %14 = shr.s %13, 1:i64
  %15 = shr.u %14, 1:i64
  ret %15
}

func export @floats : (f64, f32) -> f64 {
^b0(%0: f64, %1: f32):
  %2 = add %0, 1.5:f64
  %3 = sub %2, 0.25:f64
  %4 = mul %3, %0
  %5 = div %4, 3:f64
  %6 = rem %5, 7:f64
  %7 = fneg %6
  %8 = cast.fpext %1 : f64
  %9 = add %7, %8
  ret %9
}

func export @logic : (bool zext, bool zext) -> bool zext {
^b0(%0: bool, %1: bool):
  %2 = and %0, %1
  %3 = or %2, true:bool
  %4 = not %3
  ret %4
}
