nir 1.0

func export pressa @execute : (ptr, i8 sext) -> i32 sext {
^b0(%0: ptr, %1: i8):
  %2 = var 0:i32
  %3 = cast.sext %1 : i32
  %4 = sub %2, %3
  %5 = var 4:i64
  %6 = cast.sext %4 : i64
  %7 = mul %6, %5
  %8 = add %0, %7
  [9] assign %0, %8
  %10 = var %0
  %11 = load %10 : i32
  [12] ret %11
}
