nir 1.0

func export pressa @execute : (ptr) -> i32 sext {
^b0(%0: ptr):
  %1 = var 0:i32
  %2 = var %0
  %3 = load %2 : i32
  %4 = add %1, %3
  [5] assign %1, %4
  %6 = var 4:i64
  %7 = add %0, %6
  %8 = load %7 : i32
  %9 = add %1, %8
  [10] assign %1, %9
  %11 = var 8:i64
  %12 = add %0, %11
  %13 = load %12 : i32
  %14 = add %1, %13
