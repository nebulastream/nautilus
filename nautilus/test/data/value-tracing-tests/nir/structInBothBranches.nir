nir 1.0

func export pressa @execute : (i32 sext) -> i32 sext {
  alloca 8 align 4
  alloca 8 align 4
^b0(%0: i32):
  %1 = var 0:i32
  %2 = cmp.gt.s %0, %1
  [3] condbr %2, ^b1, ^b2 prob 2147483647
^b1:
  %4 = alloca 0
  [5] store %4, %0
  %6 = var %4
  %7 = load %6 : i32
  [8] ret %7
^b2:
  %9 = alloca 1
  %10 = var 42:i32
  [11] store %9, %10
  %12 = var %9
  %13 = load %12 : i32
  [14] ret %13
}
