nir 1.0
pointer #p0 = callee local 0x0
callee #c0 = external #p0 : (ptr, i32 sext, i32 sext) -> void attrs(noUnwind)

func export pressa @execute : (i32 sext) -> i32 sext {
  alloca 8 align 4
^b0(%0: i32):
  %1 = alloca 0
  %2 = var %1
  [3] call #c0(%2, %0, %0)
  %4 = var %1
  %5 = load %4 : i32
  [6] ret %5
}
