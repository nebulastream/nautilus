  %8 = var 4:i64
  %9 = add %4, %8
  [10] store %9, %7
  %11 = var 8:i64
  %12 = add %4, %11
  [13] store %12, %0
  %14 = var %4
  %15 = load %14 : i8
  %16 = var 4:i64
  %17 = add %4, %16
  %18 = load %17 : i32
  %19 = var 8:i64
  %20 = add %4, %19
