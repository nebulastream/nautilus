nir 1.0

func export pressa @execute : (i64) -> i64 {
  alloca 16 align 8
^b0(%0: i64):
  %1 = var 0:i64
  %2 = cmp.gt.s %0, %1
  [3] condbr %2, ^b1, ^b2 prob 2147483647
^b1:
  %4 = alloca 0
  %5 = var 1:i8
  [6] store %4, %5
