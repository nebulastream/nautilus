nir 1.0

func export pressa @execute : () -> i32 sext {
  alloca 8 align 4
^b0:
  %0 = alloca 0
  %1 = var 10:i32
  [2] store %0, %1
  %3 = var 32:i32
  %4 = var 4:i64
  %5 = add %0, %4
  [6] store %5, %3
  %7 = var %0
  %8 = var 4:i64
  %9 = add %0, %8
  %10 = load %7 : i32
  %11 = load %9 : i32
  %12 = add %10, %11
  [13] ret %12
}
