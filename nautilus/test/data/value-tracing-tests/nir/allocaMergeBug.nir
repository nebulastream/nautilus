nir 1.0
pointer #p0 = callee local 0x0
pointer #p1 = callee local 0x0
pointer #p2 = callee local 0x0
callee #c0 = external #p0 : (ptr) -> void attrs(noUnwind)
callee #c1 = external #p1 : (ptr) -> void attrs(noUnwind)
callee #c2 = external #p2 : (ptr) -> i64 attrs(noUnwind)

func export pressa @execute : () -> i64 {
  alloca 8 align 4
  alloca 64 align 8
^b0:
  %0 = var 0:i32
  %1 = alloca 0
  %2 = var %1
  [3] call #c0(%2)
  %4 = var %1
  %5 = load %4 : i32
  [6] assign %0, %5
  %7 = alloca 1
  %8 = var %7
  [9] call #c1(%8)
  %10 = var %7
  %11 = call #c2(%10)
  %12 = cast.sext %0 : i64
  %13 = add %11, %12
  [14] ret %13
}
