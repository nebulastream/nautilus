nir 1.0
pointer #p0 = callee local 0x0
callee #c0 = external #p0 : (ptr, ptr, i64) -> ptr attrs(noUnwind)

func export pressa @execute : () -> i32 sext {
  alloca 8 align 4
  alloca 8 align 4
^b0:
  %0 = alloca 0
  %1 = var 42:i32
  [2] store %0, %1
  %3 = var 10:i32
  %4 = var 4:i64
  %5 = add %0, %4
  [6] store %5, %3
  %7 = alloca 1
  %8 = var 8:i64
  %9 = call #c0(%7, %0, %8)
  %10 = var %7
  %11 = var 4:i64
  %12 = add %7, %11
  %13 = load %10 : i32
  %14 = load %12 : i32
  %15 = add %13, %14
  [16] ret %15
}
