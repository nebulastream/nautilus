nir 1.0
pointer #p0 = callee local 0x0
pointer #p1 = callee local 0x0
pointer #p2 = callee local 0x0
callee #c0 = external #p0 : (ptr) -> void attrs(noUnwind)
callee #c1 = external #p1 : (ptr) -> void attrs(noUnwind)
callee #c2 = external #p2 : (ptr) -> i64 attrs(noUnwind)

func export pressa @execute : (i32 sext) -> i64 {
  alloca 8 align 4
  alloca 64 align 8
^b0(%0: i32):
  %1 = var 0:i64
  %2 = var 0:i32
  [3] br ^b1
^b1:
  %4 = cmp.lt.s %2, %0
  [5] condbr %4, ^b2, ^b3 prob 2147483647
^b2:
  %6 = var 0:i32
  %7 = alloca 0
  %8 = var %7
  [9] call #c0(%8)
  %10 = var %7
  %11 = load %10 : i32
  [12] assign %6, %11
  %13 = alloca 1
  %14 = var %13
  [15] call #c1(%14)
  %16 = var %13
  %17 = call #c2(%16)
  %18 = add %1, %17
  %19 = cast.sext %6 : i64
  %20 = add %18, %19
  [21] assign %1, %20
  %22 = var 1:i32
  %23 = add %2, %22
  [24] assign %2, %23
  [25] br ^b1
^b3:
  [26] ret %1
}
