nir 1.0

func export pressa @execute : (i64, i8 sext, i16 sext) -> i64 {
  alloca 16 align 8
^b0(%0: i64, %1: i8, %2: i16):
  %3 = alloca 0
  [4] store %3, %0
  %5 = var 8:i64
  %6 = add %3, %5
  [7] store %6, %1
  %8 = var 10:i64
  %9 = add %3, %8
  [10] store %9, %2
  %11 = var %3
  %12 = load %11 : i64
  %13 = var 8:i64
  %14 = add %3, %13
  %15 = load %14 : i8
  %16 = var 10:i64
  %17 = add %3, %16
  %18 = load %17 : i16
  %19 = cast.sext %15 : i64
  %20 = add %12, %19
  %21 = cast.sext %18 : i64
  %22 = add %20, %21
  [23] ret %22
}
