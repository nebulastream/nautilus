nir 1.0
pointer #p0 = callee local 0x0
callee #c0 = external #p0 : (ptr, i32 sext, i32 sext) -> void attrs(noUnwind)

func export pressa @execute : (i32 sext, i32 sext) -> i32 sext {
  alloca 8 align 4
^b0(%0: i32, %1: i32):
  %2 = alloca 0
  [3] call #c0(%2, %0, %1)
  %4 = var %2
  %5 = var 4:i64
  %6 = add %2, %5
  %7 = load %4 : i32
  %8 = load %6 : i32
  %9 = add %7, %8
  [10] ret %9
}
