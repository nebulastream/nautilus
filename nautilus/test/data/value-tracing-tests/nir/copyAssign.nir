nir 1.0
pointer #p0 = callee local 0x0
callee #c0 = external #p0 : (ptr, ptr, i64) -> ptr attrs(noUnwind)

func export pressa @execute : () -> i32 sext {
  alloca 8 align 4
  alloca 8 align 4
^b0:
  %0 = alloca 0
  %1 = var 42:i32
  [2] store %0, %1
  %3 = alloca 1
  %4 = var 8:i64
  %5 = call #c0(%3, %0, %4)
  %6 = var %3
  %7 = load %6 : i32
  [8] ret %7
}
