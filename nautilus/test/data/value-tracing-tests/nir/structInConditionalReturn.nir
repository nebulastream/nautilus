nir 1.0

func export pressa @execute : (i32 sext) -> i32 sext {
  alloca 8 align 4
^b0(%0: i32):
  %1 = var 0:i32
  %2 = cmp.gt.s %0, %1
  [3] condbr %2, ^b1, ^b2 prob 2147483647
^b1:
  %4 = alloca 0
  [5] store %4, %0
  %6 = var 10:i32
  %7 = var 4:i64
  %8 = add %4, %7
  [9] store %8, %6
  %10 = var %4
  %11 = var 4:i64
  %12 = add %4, %11
  %13 = load %10 : i32
  %14 = load %12 : i32
  %15 = add %13, %14
  [16] ret %15
^b2:
  [17] ret %0
}
