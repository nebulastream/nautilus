nir 1.0

func export pressa @execute : (i32 sext) -> i32 sext {
^b0(%0: i32):
  %1 = var 10:i32
  %2 = cmp.gt.s %0, %1
  %3 = var 5:i32
  %4 = cmp.gt.s %0, %3
  %5 = var %4
  %6 = var 100:i32
  %7 = var 50:i32
  %8 = select %5, %6, %7
  %9 = var %2
  %10 = var 200:i32
  %11 = var %8
  %12 = select %9, %10, %11
  [13] ret %12
}
