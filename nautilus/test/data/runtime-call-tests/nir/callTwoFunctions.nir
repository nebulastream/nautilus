nir 1.0
pointer #p0 = callee local 0x0
pointer #p1 = callee local 0x0
callee #c0 = external #p0 : (i32 sext, i32 sext) -> i32 sext attrs(noUnwind)
callee #c1 = external #p1 : (i32 sext, i32 sext) -> i32 sext attrs(noUnwind)

func export pressa @execute : (i32 sext, i32 sext) -> i32 sext {
^b0(%0: i32, %1: i32):
  %2 = call #c0(%0, %1)
  %3 = call #c1(%0, %1)
  %4 = add %2, %3
  [5] ret %4
}
