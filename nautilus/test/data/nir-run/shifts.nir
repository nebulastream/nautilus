; Shifts take the amount modulo the bit width (13 §5.3, D10); shr.u is logical, shr.s arithmetic.
nir 1.0

func export @shl32 : (i32, i32) -> i32 {
^b0(%0: i32, %1: i32):
  %2 = shl %0, %1
  ret %2
}
; run @shl32(1, 4) = 16
; run @shl32(1, 32) = 1
; run @shl32(1, 33) = 2
; run @shl32(3, 31) = -2147483648
; run @shl32(1, -1) = -2147483648

func export @shr32s : (i32, i32) -> i32 {
^b0(%0: i32, %1: i32):
  %2 = shr.s %0, %1
  ret %2
}
; run @shr32s(-16, 2) = -4
; run @shr32s(-16, 34) = -4
; run @shr32s(16, 33) = 8

func export @shr32u : (i32, i32) -> i32 {
^b0(%0: i32, %1: i32):
  %2 = shr.u %0, %1
  ret %2
}
; run @shr32u(-16, 28) = 15
; run @shr32u(-16, 60) = 15

func export @shl64 : (i64, i64) -> i64 {
^b0(%0: i64, %1: i64):
  %2 = shl %0, %1
  ret %2
}
; run @shl64(1, 63) = -9223372036854775808
; run @shl64(1, 64) = 1
; run @shl64(1, 65) = 2

func export @shr64u : (i64, i64) -> i64 {
^b0(%0: i64, %1: i64):
  %2 = shr.u %0, %1
  ret %2
}
; run @shr64u(-1, 63) = 1
; run @shr64u(-1, 127) = 1

func export @shl8 : (i8 sext, i8 sext) -> i8 sext {
^b0(%0: i8, %1: i8):
  %2 = shl %0, %1
  ret %2
}
; run @shl8(1, 7) = -128
; run @shl8(1, 8) = 1
; run @shl8(3, 9) = 6

func export @shr8s : (i8 sext, i8 sext) -> i8 sext {
^b0(%0: i8, %1: i8):
  %2 = shr.s %0, %1
  ret %2
}
; run @shr8s(-128, 7) = -1
; run @shr8s(-128, 15) = -1

func export @shr16u : (i16 zext, i16 zext) -> i16 zext {
^b0(%0: i16, %1: i16):
  %2 = shr.u %0, %1
  ret %2
}
; run @shr16u(32768, 15) = 1
; run @shr16u(32768, 31) = 1

func export @shconst : (i32) -> i32 {
^b0(%0: i32):
  %1 = shl %0, 33:i32
  ret %1
}
; run @shconst(5) = 10
