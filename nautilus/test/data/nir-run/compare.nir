; Comparison and select (13 §5.4).
nir 1.0

func export @lts : (i32, i32) -> bool zext {
^b0(%0: i32, %1: i32):
  %2 = cmp.lt.s %0, %1
  ret %2
}
; run @lts(-1, 1) = true
; run @lts(1, -1) = false
; run @lts(1, 1) = false

func export @ltu : (i32, i32) -> bool zext {
^b0(%0: i32, %1: i32):
  %2 = cmp.lt.u %0, %1
  ret %2
}
; run @ltu(-1, 1) = false
; run @ltu(1, -1) = true

func export @leu8 : (i8 zext, i8 zext) -> bool zext {
^b0(%0: i8, %1: i8):
  %2 = cmp.le.u %0, %1
  ret %2
}
; run @leu8(200, 200) = true
; run @leu8(200, 100) = false

func export @ges16 : (i16 sext, i16 sext) -> bool zext {
^b0(%0: i16, %1: i16):
  %2 = cmp.ge.s %0, %1
  ret %2
}
; run @ges16(-5, -6) = true
; run @ges16(-6, -5) = false

func export @gtu64 : (i64, i64) -> bool zext {
^b0(%0: i64, %1: i64):
  %2 = cmp.gt.u %0, %1
  ret %2
}
; run @gtu64(-1, 1) = true

func export @eqne : (i64, i64) -> i32 {
^b0(%0: i64, %1: i64):
  %2 = cmp.eq %0, %1
  %3 = cmp.ne %0, %1
  %4 = select %2, 10:i32, 20:i32
  %5 = select %3, 1:i32, 2:i32
  %6 = add %4, %5
  ret %6
}
; run @eqne(5, 5) = 12
; run @eqne(5, 6) = 21

func export @floatcmp : (f64, f64) -> i32 {
^b0(%0: f64, %1: f64):
  %2 = cmp.lt %0, %1
  %3 = cmp.le %0, %1
  %4 = cmp.eq %0, %1
  %5 = cmp.ne %0, %1
  %6 = cmp.gt %0, %1
  %7 = cmp.ge %0, %1
  %8 = select %2, 1:i32, 0:i32
  %9 = select %3, 2:i32, 0:i32
  %10 = select %4, 4:i32, 0:i32
  %11 = select %5, 8:i32, 0:i32
  %12 = select %6, 16:i32, 0:i32
  %13 = select %7, 32:i32, 0:i32
  %14 = add %8, %9
  %15 = add %14, %10
  %16 = add %15, %11
  %17 = add %16, %12
  %18 = add %17, %13
  ret %18
}
; run @floatcmp(1.0, 2.0) = 11
; run @floatcmp(2.0, 2.0) = 38
; run @floatcmp(3.0, 2.0) = 56
; run @floatcmp(nan, 2.0) = 8
; run @floatcmp(2.0, nan) = 8
; run @floatcmp(nan, nan) = 8
; run @floatcmp(0.0, -0.0) = 38

func export @boolcmp : (bool zext, bool zext) -> bool zext {
^b0(%0: bool, %1: bool):
  %2 = cmp.eq %0, %1
  ret %2
}
; run @boolcmp(true, true) = true
; run @boolcmp(true, false) = false

func export @ptrcmp : (ptr, ptr) -> i32 {
^b0(%0: ptr, %1: ptr):
  %2 = cmp.lt %0, %1
  %3 = cmp.eq %0, %1
  %4 = select %2, 1:i32, 0:i32
  %5 = select %3, 2:i32, 0:i32
  %6 = add %4, %5
  ret %6
}
; run @ptrcmp(1, 2) = 1
; run @ptrcmp(2, 2) = 2
; run @ptrcmp(-1, 2) = 0

func export @selptr : (bool zext, ptr, ptr) -> ptr {
^b0(%0: bool, %1: ptr, %2: ptr):
  %3 = select %0, %1, %2
  ret %3
}
; run @selptr(true, 16, 32) = 16
; run @selptr(false, 16, 32) = 32

func export @selflt : (bool zext, f32, f32) -> f32 {
^b0(%0: bool, %1: f32, %2: f32):
  %3 = select %0, %1, %2
  ret %3
}
; run @selflt(true, 1.5, 2.5) = 1.5
; run @selflt(false, 1.5, 2.5) = 2.5
