nir 1.0
pointer #p0 = callee local 0x0
callee #c0 = internal @add : (i32 sext, i32 sext) -> i32 sext
callee #c1 = external #p0 : (ptr, i32 sext, i32 sext) -> i32 sext attrs(noUnwind)

func export pressa @execute : (i32 sext, i32 sext) -> i32 sext {
^b0(%0: i32, %1: i32):
  %2 = funcaddr #c0
  %3 = call #c1(%2, %0, %1)
  [4] ret %3
}

func pressa @add : (i32 sext, i32 sext) -> i32 sext {
^b0(%0: i32, %1: i32):
  %2 = add %0, %1
  [3] ret %2
}
