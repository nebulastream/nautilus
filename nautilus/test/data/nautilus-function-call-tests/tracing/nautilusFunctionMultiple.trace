ADD10:
B0($1:i32)
	CONST	$2	10	:i32
	ADD	$3	$1	$2	:i32
	RETURN	$0	$3	:i32

EXECUTE:
B0($1:i32)
	CALL_WITH_EXCEPTION_HANDLING	$2	add10($1)	:i32
	CALL_WITH_EXCEPTION_HANDLING	$3	multiply2($2)	:i32
	CALL_WITH_EXCEPTION_HANDLING	$4	subtract5($3)	:i32
	RETURN	$0	$4	:i32

MULTIPLY2:
B0($1:i32)
	CONST	$2	2	:i32
	MUL	$3	$1	$2	:i32
	RETURN	$0	$3	:i32

SUBTRACT5:
B0($1:i32)
	CONST	$2	5	:i32
	SUB	$3	$1	$2	:i32
	RETURN	$0	$3	:i32

