nir 1.0

func export pressa @execute : (i32 sext) -> i32 sext {
^b0(%0: i32):
  %1 = var %0
  %2 = var 1:i32
  %3 = add %1, %2
  [4] assign %1, %3
  %5 = var 1:i32
  %6 = add %1, %5
  [7] assign %1, %6
  %8 = var 1:i32
  %9 = add %1, %8
  [10] assign %1, %9
  %11 = var 1:i32
  %12 = add %1, %11
  [13] assign %1, %12
  %14 = var 1:i32
  %15 = add %1, %14
  [16] assign %1, %15
  [17] ret %1
}
