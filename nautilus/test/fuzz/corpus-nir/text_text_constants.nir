nir 1.0

func export @constants : () -> void {
^b0:
  %0 = add 0:i8, 127:i8
  %1 = add -128:i8, -1:i8
  %2 = add 32767:i16, -32768:i16
  %3 = add 2147483647:i32, -2147483648:i32
  %4 = add 9223372036854775807:i64, -9223372036854775808:i64
  %5 = and true:bool, false:bool
  %6 = add 1.5:f64, -0:f64
  %7 = add 0.1:f32, 3.4028235e+38:f32
  %8 = add inf:f64, -inf:f64
  %9 = add nan(0x8000000000000):f64, -nan(0x1):f64
  %10 = add 5:i64[audited], 6:i64[raw]
  %11 = add 1.25:f64[audited], 2:f64
  ret
}
