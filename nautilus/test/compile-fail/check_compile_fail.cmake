# Compiles SOURCE with the public headers. The first line names the expectation: `// EXPECT-ERROR: <text>` (the
# compilation must fail and its diagnostics contain <text>) or `// EXPECT-SUCCESS` (it must compile; a control that keeps
# the include paths honest).
file(STRINGS ${SOURCE} first LIMIT_COUNT 1)
set(args -std=c++20 -fsyntax-only)
foreach (dir ${INCLUDES})
    list(APPEND args -I${dir})
endforeach ()
list(APPEND args ${SOURCE})
execute_process(COMMAND ${CXX} ${args} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if (first MATCHES "EXPECT-SUCCESS")
    if (NOT status EQUAL 0)
        message(FATAL_ERROR "${SOURCE} should compile:\n${err}")
    endif ()
elseif (first MATCHES "^// EXPECT-ERROR: (.*)$")
    set(expected "${CMAKE_MATCH_1}")
    if (status EQUAL 0)
        message(FATAL_ERROR "${SOURCE} compiled, but it must not")
    endif ()
    string(FIND "${err}" "${expected}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "${SOURCE}: the diagnostics do not contain \"${expected}\":\n${err}")
    endif ()
else ()
    message(FATAL_ERROR "${SOURCE}: the first line must be // EXPECT-ERROR: <text> or // EXPECT-SUCCESS")
endif ()
