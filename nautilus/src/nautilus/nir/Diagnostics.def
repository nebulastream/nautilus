// The diagnostic codes of NIR (13-nir-spec.md §6.6), generated from that table. Codes are never renumbered or reused
// within a major version. NIR-V: verifier, NIR-L: loader, NIR-P: text parser.
//
// NIR_DIAG(Id, "code", "rule", "check")
#ifndef NIR_DIAG
#error "define NIR_DIAG before including Diagnostics.def"
#endif
NIR_DIAG(V001, "NIR-V001", "§6.1.1", "a function has at least one block")
NIR_DIAG(V002, "NIR-V002", "§6.1.1", "a block ends in exactly one terminator; no terminator elsewhere")
NIR_DIAG(V003, "NIR-V003", "§3.1", "the opcode is a core opcode of this version or a registered extension")
NIR_DIAG(V004, "NIR-V004", "§3.1, §6.1.3", "reserved flag bits, unused operand fields and padding are 0")
NIR_DIAG(V005, "NIR-V005", "§3.2, §6.1.2", "a value reference is in range, not reserved, and names a non-void instruction of the same function or a constant")
NIR_DIAG(V006, "NIR-V006", "§5, §6.1.3", "operand and result types match the opcode's table")
NIR_DIAG(V007, "NIR-V007", "§6.1.5, §4.7", "a table index is in range, and a pointers index names an entry of the kind its field requires (§4.7 \"Kinds and their users\")")
NIR_DIAG(V008, "NIR-V008", "§3.3, §6.1.5", "an extra list is in bounds and does not overlap another")
NIR_DIAG(V009, "NIR-V009", "§6.1.4", "branch argument count and types match the target's blockargs")
NIR_DIAG(V010, "NIR-V010", "§6.1.6", "ret matches the signature's result")
NIR_DIAG(V011, "NIR-V011", "§5.7", "call arguments match the signature")
NIR_DIAG(V012, "NIR-V012", "§3.4", "the unwind entry has a form allowed at the function's level")
NIR_DIAG(V013, "NIR-V013", "§5.7", "a call with noUnwind has NO_UNWIND")
NIR_DIAG(V014, "NIR-V014", "§5.7", "a thunk is present exactly where required (a may-throw external call or call.indirect; never on an internal, imported or intrinsic call), and is a capture-thunk entry")
NIR_DIAG(V015, "NIR-V015", "§5.7", "funcaddr does not name an intrinsic")
NIR_DIAG(V016, "NIR-V016", "§5.10", "div/rem flags: checked only on integers, with an unwind entry other than NO_UNWIND; c = 0 otherwise")
NIR_DIAG(V017, "NIR-V017", "§5.4", "cmp predicate in range; unsigned bit only on ordered integer predicates; bool only eq/ne")
NIR_DIAG(V018, "NIR-V018", "§5.5", "the cast kind allows the source and result types")
NIR_DIAG(V019, "NIR-V019", "§5.6", "the alignment code is valid and not an explicit natural alignment")
NIR_DIAG(V020, "NIR-V020", "§5.9", "blockarg position and placement")
NIR_DIAG(V030, "NIR-V030", "§6.1.8", "exactly one module record")
NIR_DIAG(V031, "NIR-V031", "§6.1.8, §4.5", "function records are valid (level and visibility in range); function names are unique and non-empty")
NIR_DIAG(V032, "NIR-V032", "§4.6", "a callee's signature equals its target's")
NIR_DIAG(V033, "NIR-V033", "§4.6", "an internal callee's attributes equal the function's under GUARANTEE_MASK")
NIR_DIAG(V034, "NIR-V034", "§4.6.2", "reserved attribute bits are 0")
NIR_DIAG(V035, "NIR-V035", "§4.5", "the signature of an exported function, an external callee, a call.indirect or the target of a funcaddr uses only types with a C ABI (TypeInfo.cabi for extension types)")
NIR_DIAG(V036, "NIR-V036", "§4.5.1", "type words and extension kinds are valid")
NIR_DIAG(V037, "NIR-V037", "§6.1.9", "imports are unique and do not name the module itself")
NIR_DIAG(V038, "NIR-V038", "§8.5", "a deserialized image has no imports")
NIR_DIAG(V039, "NIR-V039", "§4.2", "constant records are valid")
NIR_DIAG(V040, "NIR-V040", "§4.7", "pointer records are valid; processToken is set exactly when needed")
NIR_DIAG(V041, "NIR-V041", "§4.8", "binding names are unique; binding records are valid")
NIR_DIAG(V042, "NIR-V042", "§4.10", "data objects are valid")
NIR_DIAG(V043, "NIR-V043", "§4.5", "allocas are valid")
NIR_DIAG(V044, "NIR-V044", "§4.5.2", "function string attributes are sorted, unique and prefixed")
NIR_DIAG(V045, "NIR-V045", "§4.6", "destructor callees have signature (ptr) -> void")
NIR_DIAG(V046, "NIR-V046", "§8.4", "extension records are valid and their names parse")
NIR_DIAG(V050, "NIR-V050", "§6.2", "assign targets a variable definition of the same type, never a constant")
NIR_DIAG(V051, "NIR-V051", "§6.2", "every use is reached by a definition on every path")
NIR_DIAG(V052, "NIR-V052", "§6.2", "no block arguments except parameters; branch argument lists are empty")
NIR_DIAG(V053, "NIR-V053", "§6.2", "no landing-pad flags")
NIR_DIAG(V054, "NIR-V054", "§4.3", "every instruction belongs to exactly one block")
NIR_DIAG(V055, "NIR-V055", "§5.10", "every integer div/rem is checked and has a cleanup list")
NIR_DIAG(V056, "NIR-V056", "§3.4", "cleanup-list entries name destructor callees and ptr values")
NIR_DIAG(V060, "NIR-V060", "§6.3", "no assign or var")
NIR_DIAG(V061, "NIR-V061", "§6.3", "dominance, including over unwind edges")
NIR_DIAG(V062, "NIR-V062", "§6.3", "layout: forward edges, reducible loops contiguous, pads last and in order")
NIR_DIAG(V063, "NIR-V063", "§6.3", "every block is reachable")
NIR_DIAG(V064, "NIR-V064", "§6.3", "landing-pad entry, arguments and exits")
NIR_DIAG(V065, "NIR-V065", "§5.7, §5.9", "calls in pads have NO_UNWIND or NO_CLEANUP; resume only in pads")
NIR_DIAG(V066, "NIR-V066", "§6.3", "the entry block is not a landing pad, and its arguments equal the signature's parameters")
NIR_DIAG(V067, "NIR-V067", "§4.1, §4.3", "blocks are contiguous and cover the function's instructions; the instruction, block and alloca ranges of the functions are contiguous and in functions order")
NIR_DIAG(V070, "NIR-V070", "§5.11.1", "an extension instruction matches its operand shape")
NIR_DIAG(V071, "NIR-V071", "§5.11", "an extension instruction passes its Signature and verify hook")
NIR_DIAG(V072, "NIR-V072", "04 §3.3", "a target-restricted extension operation is valid for the compile target")
NIR_DIAG(L001, "NIR-L001", "§8.1", "magic")
NIR_DIAG(L002, "NIR-L002", "§8.2", "major version higher than the reader's")
NIR_DIAG(L003, "NIR-L003", "§8.2", "unknown incompatFeatures bit")
NIR_DIAG(L004, "NIR-L004", "§8.1", "totalSize differs from the buffer length")
NIR_DIAG(L005, "NIR-L005", "§8.1", "checksum")
NIR_DIAG(L006, "NIR-L006", "§8.1", "section table: order, duplicates, alignment, bounds, overlap")
NIR_DIAG(L007, "NIR-L007", "§8.1", "stride below the record size, or a byte or u32 section with another stride")
NIR_DIAG(L008, "NIR-L008", "§8.1", "a configured limit is exceeded")
NIR_DIAG(L009, "NIR-L009", "§8.1", "the module section is missing")
NIR_DIAG(L010, "NIR-L010", "§8.4", "an extension is missing in the registry")
NIR_DIAG(L011, "NIR-L011", "§8.4", "an extension version is outside the accepted range")
NIR_DIAG(L012, "NIR-L012", "§8.4", "an intrinsic callee's signature differs from the registered one")
NIR_DIAG(L013, "NIR-L013", "—", "not used in 1.0 (unavailable type instances load, §8.4); reserved")
NIR_DIAG(L014, "NIR-L014", "§4.7", "the process token differs from this process's")
NIR_DIAG(L015, "NIR-L015", "§4.7", "a portable pointer does not resolve")
NIR_DIAG(L016, "NIR-L016", "§8.1", "a pre-SSA function in an image loaded for execution")
NIR_DIAG(L017, "NIR-L017", "§8.1", "the verifier rejects the loaded module (the diagnostic also carries the NIR-V code)")
NIR_DIAG(P001, "NIR-P001", "§9.1", "lexical error")
NIR_DIAG(P002, "NIR-P002", "§9.2", "syntax error")
NIR_DIAG(P003, "NIR-P003", "§9.4", "undefined or out-of-order reference (%N, ^bN, #…, @…)")
NIR_DIAG(P004, "NIR-P004", "§9.4", "a printed id differs from the position it denotes")
NIR_DIAG(P005, "NIR-P005", "§9.4", "unknown extension name, or a version the registry does not accept")
NIR_DIAG(P006, "NIR-P006", "§9.1", "a literal out of range for its type")
